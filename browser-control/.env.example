# Copy to .env and replace placeholders. Never commit credentials.
CONTROL_ACCESS_TOKEN=replace-with-a-long-random-controller-token
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173
HOST=127.0.0.1
PORT=8787
RUNTIME_DIR=./.runtime
PUBLIC_BASE_URL=http://127.0.0.1:8787
ICTL_BIN=iphone-control
# Browser sessions request source JPEG and persistent low-latency WDA settings.
# Set to 0 to keep normal WDA screenshot/gesture settings; reconnect to apply.
ICTL_LOW_LATENCY=1
# Optional prebuilt Rust gateway executable for npm start. Otherwise cargo run is used.
# Set GATEWAY_BIN in the shell environment, before launching the startup script.
# GATEWAY_BIN=/absolute/path/to/iphone-control-gateway
# WEB_DIST_DIR=./dist
# Local PaddleOCR worker for AI observation. npm start runs from browser-control.
# Install ocr/requirements.txt into a Python 3.11 virtual environment first.
# OCR_PYTHON=/absolute/path/to/.venv/bin/python3
# OCR_WORKER=ocr/worker.py
# Optional AI: leave all three blank for manual-only operation.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
